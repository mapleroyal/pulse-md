{
  "name": "pulse-md",
  "productName": "Pulse MD",
  "desktopName": "pulse-md.desktop",
  "private": true,
  "version": "1.0.0",
  "description": "A fast, local-first Markdown reader and editor for the desktop.",
  "author": "mapleroyal",
  "copyright": "Copyright © 2026 mapleroyal",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "markdown",
    "editor",
    "reader",
    "electron",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapleroyal/pulse-md.git"
  },
  "bugs": {
    "url": "https://github.com/mapleroyal/pulse-md/issues"
  },
  "homepage": "https://github.com/mapleroyal/pulse-md#readme",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "npm@11.12.1",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-development.mjs",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "npm run build:native && node scripts/build-electron.mjs",
    "build:native": "node scripts/build-native-macos.mjs && node scripts/build-cli.mjs",
    "build:mac": "node scripts/build-release.mjs mac",
    "build:win": "node scripts/build-release.mjs win",
    "build:linux": "node scripts/build-release.mjs linux",
    "cli:dev": "node scripts/cli-development.mjs",
    "bundle:check": "node scripts/verify-csp.mjs index.html dist/index.html && node scripts/report-bundle.mjs --check",
    "bundle:report": "node scripts/report-bundle.mjs",
    "bundle:test": "node --test scripts/report-bundle.test.mjs scripts/verify-csp.test.mjs scripts/macos-icon-assets.test.mjs scripts/build-release.test.mjs scripts/after-extract.test.mjs scripts/electron-download-config.test.mjs scripts/e2e-worker-policy.test.mjs scripts/windows-installer-launch.test.mjs scripts/windows-msvc.test.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run test:cli && npm run bundle:test && npm run build && npm run bundle:check",
    "check:full": "npm run check && npm run test:e2e",
    "benchmark:launch": "node scripts/benchmark-launch.mjs",
    "icon:build": "scripts/build-icon.sh",
    "icon:build:portable": "node scripts/build-portable-icons.mjs",
    "lint": "eslint .",
    "mac:registrations:check": "node scripts/macos-app-registrations.mjs check",
    "mac:registrations:clean": "node scripts/macos-app-registrations.mjs clean",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,cjs,json,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"*.{js,cjs,json,yml}\" --ignore-path .prettierignore",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:cli": "node scripts/build-cli.mjs && node --test scripts/cli-development.test.mjs scripts/cli-helper.test.mjs scripts/cli-helper-windows.test.mjs",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:packaged": "node scripts/test-packaged-runtime.mjs",
    "package": "node scripts/package-local.mjs",
    "package:mac": "node scripts/package-local.mjs mac",
    "package:win": "node scripts/package-local.mjs win",
    "package:linux": "node scripts/package-local.mjs linux",
    "install:local": "node scripts/install-local.mjs",
    "install:mac:dev": "node scripts/install-macos-maintainer.mjs",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "6.43.6",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.2.6",
    "@fontsource-variable/cascadia-code": "^5.2.2",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/google-sans-code": "^5.2.4",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.1",
    "@shadcn/react": "^0.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.13",
    "embla-carousel-react": "^8.6.0",
    "gemoji": "^8.1.0",
    "input-otp": "^1.4.2",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "katex": "0.16.47",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10",
    "@mixmark-io/domino": "^2.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.6",
    "esbuild": "^0.28.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "js-yaml": "^4.3.1",
    "node-api-headers": "^1.9.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
